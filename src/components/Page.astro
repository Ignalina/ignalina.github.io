---
import Layout from '../layouts/Layout.astro';
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang];
const siteUrl = 'https://www.ignalina.dk/';

// Varje produkt som programvara med sin kodkälla, så att sökmotorer och
// assistenter kan koppla namnen till Ignalina.
const graph = c.products.map((p) => ({
  '@type': 'SoftwareApplication',
  name: p.name,
  description: p.what,
  applicationCategory: 'DeveloperApplication',
  ...(p.href ? { url: p.href, sameAs: p.href } : {}),
  author: { '@id': siteUrl + '#organization' },
  image: siteUrl + p.icon.replace(/^\//, ''),
}));

// Siffrorna som stiger ur de två kyltornen: läge i procent av bildens bredd,
// varaktighet och fördröjning, så att kolumnerna inte går i takt.
const binary = [
  { x: 19, t: 15, d: 0 },
  { x: 25, t: 18, d: -6 },
  { x: 31, t: 13, d: -11 },
  { x: 57, t: 16, d: -3 },
  { x: 63, t: 14, d: -9 },
  { x: 69, t: 19, d: -14 },
];
const bits = (seed: number) => {
  let s = seed * 2654435761;
  let out = '';
  for (let i = 0; i < 22; i++) {
    s = (s * 1103515245 + 12345) & 0x7fffffff;
    out += (s >> 16) & 1 ? '1' : '0';
    if (i % 4 === 3) out += ' ';
  }
  return out;
};
---

<Layout ui={lang} title={c.title} description={c.description} path={`/${c.path}`} alternates graph={graph}>
  <!-- Hjälten: bilden med stigande binära tal, rubriken bredvid. -->
  <section class="wrap pt-6 md:pt-10 pb-14 md:pb-20 grid grid-cols-1 md:grid-cols-[minmax(0,46%)_minmax(0,1fr)] gap-8 md:gap-14 items-center">
    <figure class="kunst relative m-0 min-w-0 h-[min(64vh,34rem)] md:h-[min(78vh,44rem)] overflow-hidden">
      <img
        src="/art.webp"
        width="768"
        height="1376"
        fetchpriority="high"
        alt={c.artAlt}
        class="block w-full h-full object-cover object-[50%_28%] md:object-[50%_30%]"
      />
      <div class="binar" aria-hidden="true">
        {binary.map((b, i) => (
          <span style={`left:${b.x}%; --t:${b.t}s; --d:${b.d}s`}>{bits(i + 1)}</span>
        ))}
      </div>
    </figure>

    <div class="min-w-0 max-w-[36rem]">
      <p class="skilt text-[0.95rem] mb-6">Ignalina ApS</p>
      <h1 class="skilt text-[clamp(1.3rem,0.9rem+1.5vw,1.95rem)] leading-[1.32] tracking-[-0.005em] [text-wrap:balance] hyphens-auto break-words">{c.headline}</h1>
      <p class="mt-6">{c.intro}</p>
    </div>
  </section>

  <!-- Produkterna: märke, namn, vad det är och hur det gör det. -->
  <section id="produkter" aria-labelledby="produkter-rubrik" class="wrap pb-16 md:pb-24 scroll-mt-20">
    <h2 id="produkter-rubrik" class="skilt text-[0.95rem] mb-8">{c.productsHeading}</h2>
    <ul class="list-none m-0 p-0 grid grid-cols-1 lg:grid-cols-2 gap-x-14 gap-y-9">
      {c.products.map((p) => (
        <li class="grid grid-cols-[3.25rem_minmax(0,1fr)] gap-5 items-start">
          <img src={p.icon} alt="" width="256" height="256" class="block w-[3.25rem] h-[3.25rem]" loading="lazy" />
          <div class="min-w-0">
            <h3 class="skilt text-[1rem] leading-tight mt-1.5 mb-1.5">
              {p.href ? <a href={p.href} class="text-blaek hover:text-cherenkov">{p.name}</a> : p.name}
            </h3>
            <p class="font-semibold max-w-[36rem]">{p.what}</p>
            <p class="mt-1 text-[0.97rem] text-staal max-w-[36rem]">{p.more}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Layout>
